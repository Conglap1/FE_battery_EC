# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing & Coverage
/coverage

# Next.js & Build outputs
/.next/
/out/
/build
/dist/
.turbo/

# Environment & Sensitive files
.env*.local
.env
.env.production
.env.staging
!.env.example

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS
.DS_Store
*.pem
.vscode/
.idea/
